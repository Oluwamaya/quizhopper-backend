# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=

# Secrets — generate long random strings, e.g. `openssl rand -hex 32`.
# Required in production; the app will refuse to start without them.
JWT_SECRET=
COOKIE_KEY=

# Google OAuth Credentials (Obtain from Google Developer Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Paystack — set PAYSTACK_LIVE_MODE=true only when ready to accept real
# payments. Independent of NODE_ENV, so you can run in production with
# NODE_ENV=production while still safely testing against Paystack's test keys.
PAYSTACK_LIVE_MODE=false
PAYSTACK_SECRET_TEST_KEY=
PAYSTACK_PUBLIC_TEST_KEY=
# Required only once PAYSTACK_LIVE_MODE=true
PAYSTACK_SECRET_LIVE_KEY=
PAYSTACK_PUBLIC_LIVE_KEY=

# Optional — routes deposit settlement to a Paystack subaccount for split
# payments. Leave unset to keep depositing straight into the main account.
SUBACCOUNT_CODE=

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Optional Redis cache (falls back to in-memory if unset/unreachable).
# For local Redis with no auth, leave REDIS_PASSWORD and REDIS_TLS unset.
# For a managed provider (e.g. Upstash), set REDIS_PASSWORD and REDIS_TLS=true.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cloudinary storage for support-ticket file uploads (Dashboard > find these
# on your account home page). Optional — uploads return 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
